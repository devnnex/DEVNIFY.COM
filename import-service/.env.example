PORT=3001
HOST=0.0.0.0
ALLOWED_ORIGINS=https://USUARIO.github.io
# Enable ONLY if you use Devnify by double-clicking index.html. Bearer token still required.
ALLOW_FILE_ORIGIN=false
# Generate a long random secret. Configure it in Devnify settings; never commit it.
IMPORT_TOKEN=
# Explicit hostnames controlled/licensed and approved by the service operator.
# No wildcards. Empty disables importing. YouTube extraction is always disabled.
ALLOWED_SOURCE_HOSTS=
# Optional server-owned catalogue: video ID -> independently authorized HTTPS audio file.
# This does not scrape or extract audio from YouTube. See authorized-audio.example.json.
AUTHORIZED_YOUTUBE_AUDIO_FILE=
# Optional yt-dlp engine, only for catalogue entries with verified download permissions.
ENABLE_YOUTUBE_DOWNLOADS=false
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
DATA_DIR=./data
